<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LojinhaRPG.App.ViewModels"
        x:Class="LojinhaRPG.App.Views.Controls.ItemEditDialog"
        x:DataType="vm:ItemEditDialogViewModel"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Item">
  <StackPanel Margin="20" Spacing="10">
    <TextBlock Text="Nome" />
    <TextBox Text="{Binding Name}" Watermark="Ex: Adaga enferrujada" />

    <TextBlock Text="Preço (Sucata)" />
    <NumericUpDown Value="{Binding Price}" Minimum="0" Increment="1" FormatString="0" />

    <TextBlock Text="Estoque" />
    <NumericUpDown Value="{Binding Stock}" Minimum="0" Increment="1" FormatString="0" />

    <TextBlock Text="Informações adicionais (aparece ao passar o mouse)" />
    <TextBox Text="{Binding Info}" AcceptsReturn="True" Height="80" TextWrapping="Wrap" />

    <TextBlock Text="{Binding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
      <Button Content="Cancelar" Command="{Binding CancelCommand}" />
      <Button Content="Salvar" Command="{Binding ConfirmCommand}" Classes="accent" />
    </StackPanel>
  </StackPanel>
</Window>
