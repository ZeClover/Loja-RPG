<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LojinhaRPG.App.ViewModels"
        x:Class="LojinhaRPG.App.Views.Controls.ConfirmDialog"
        x:DataType="vm:ConfirmDialogViewModel"
        Width="380" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}">
  <StackPanel Margin="20" Spacing="16">
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Content="Cancelar" Command="{Binding NoCommand}" />
      <Button Content="Confirmar" Command="{Binding YesCommand}" Classes="accent" />
    </StackPanel>
  </StackPanel>
</Window>
